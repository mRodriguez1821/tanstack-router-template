# ==============================================================================
# TEMPLATE APP - ENVIRONMENT CONFIGURATION (.env.example)
# Copia este archivo a `.env` o `.env.local` y ajusta los valores según tu entorno.
# ==============================================================================

# Entorno de la aplicación:
# - showcase : Modo demo e interacción de componentes con BYPASS de autenticación (sin login requerido).
# - dev      : Desarrollo local con DEBUGGERS activos (TanStack Router DevTools, logs, etc.).
# - qa       : Entorno de control de calidad / pruebas SIN debuggers en pantalla.
# - prod     : Producción estricta, optimizada y sin debuggers.
VITE_APP_ENV=showcase

# URL base del Backend / API REST (sin barra final)
# Ejemplo: http://localhost:5000 o https://tudominio.com/api
VITE_API_URL=http://localhost:5000/api

# Clave secreta para el almacenamiento cifrado en el navegador (AES con encrypt-storage)
# Debe tener un mínimo de 10 caracteres (recomendado: 32 caracteres seguros)
VITE_STORAGE_SECRET_KEY=app-secret-storage-key-secure-32char
